<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GeneKerman</AssemblyName>
    <RootNamespace>GeneKerman</RootNamespace>
    <!-- Keep in sync with ModVersion.Current (shown in Settings, reported to the server). -->
    <Version>1.0.0</Version>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/</OutputPath>
    <DebugType>portable</DebugType>
    <!-- Suppress warnings about .NET Framework compatibility -->
    <NoWarn>CS0618;CS0672</NoWarn>

    <!-- Build channel. Defaults to 'production' so a plain `dotnet build` / `build.sh`
         produces a shippable DLL with the debug test panel COMPILED OUT. Only a
         non-production channel (e.g. `build.sh` with GK_CHANNEL=dev, which passes
         -p:GKChannel=dev) defines GK_DEBUG_PANEL and includes DebugTestPanel.cs. -->
    <GKChannel Condition="'$(GKChannel)' == ''">production</GKChannel>
  </PropertyGroup>

  <!-- Debug panel gate: define GK_DEBUG_PANEL only off-production. DebugTestPanel.cs
       is wrapped entirely in #if GK_DEBUG_PANEL, so in a production build it compiles
       to nothing and no test/debug code ships. -->
  <PropertyGroup Condition="'$(GKChannel)' != 'production'">
    <DefineConstants>$(DefineConstants);GK_DEBUG_PANEL</DefineConstants>
  </PropertyGroup>

  <!-- KSP Installation Path -->
  <PropertyGroup>
    <!-- Where the dev instances live. Override with -p:KSPInstances="..." to build
         against installs kept somewhere else. -->
    <KSPInstances Condition="'$(KSPInstances)' == ''">/home/ayd/Documents/KSP DEV Instances</KSPInstances>

    <!-- Reference instance: KR-KSP is the primary dev install and carries the
         ToolbarControl / ClickThroughBlocker the optional references below resolve
         from. Override on the command line with -p:KSPPath="..." to compile against
         another install.

         FK-KSP was the reference until it was deleted (2026-08-22). A HintPath that
         misses fails silently, taking UnityEngine and every KSP type with it, so a
         stale KSPPath surfaced as ~770 "type or namespace not found" errors across
         every file and named the cause in none of them. Hence the probe, the
         fallback and the explicit Error below. -->
    <KSPPath Condition="'$(KSPPath)' == ''">$(KSPInstances)/KR-KSP</KSPPath>
  </PropertyGroup>

  <!-- Managed assemblies. KSP ships them under KSP_x64_Data/Managed on some installs
       (KR-KSP, KR2-KSP) and KSP_Data/Managed on others (RSS-RO), so probe rather than
       assume: hardcoding either layout breaks the moment the reference instance moves. -->
  <PropertyGroup>
    <ManagedPath Condition="'$(ManagedPath)' == '' And Exists('$(KSPPath)/KSP_x64_Data/Managed/Assembly-CSharp.dll')">$(KSPPath)/KSP_x64_Data/Managed</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == '' And Exists('$(KSPPath)/KSP_Data/Managed/Assembly-CSharp.dll')">$(KSPPath)/KSP_Data/Managed</ManagedPath>
    <!-- The instance actually being compiled against. KSPPath cannot stand in for
         this: passed as -p:KSPPath it is a global property, which a PropertyGroup is
         not allowed to reassign, so after a fallback it still names the missing
         install — and the optional GameData references below would resolve against
         a path with no GameData in it. -->
    <GKKSPRoot Condition="'$(ManagedPath)' != ''">$(KSPPath)</GKKSPRoot>
  </PropertyGroup>

  <!-- Chosen instance has no assemblies (deleted, moved, mid-reinstall): take the
       first sibling that does, and warn. A build that quietly retargets is worse than
       one that says so, so GKCheckKSPReference reports both this and the total miss. -->
  <PropertyGroup Condition="'$(ManagedPath)' == ''">
    <_GKFallback Condition="'$(_GKFallback)' == '' And Exists('$(KSPInstances)/KR-KSP/KSP_x64_Data/Managed/Assembly-CSharp.dll')">$(KSPInstances)/KR-KSP</_GKFallback>
    <_GKFallback Condition="'$(_GKFallback)' == '' And Exists('$(KSPInstances)/KR2-KSP/KSP_x64_Data/Managed/Assembly-CSharp.dll')">$(KSPInstances)/KR2-KSP</_GKFallback>
    <_GKFallback Condition="'$(_GKFallback)' == '' And Exists('$(KSPInstances)/RSS-RO/KSP_Data/Managed/Assembly-CSharp.dll')">$(KSPInstances)/RSS-RO</_GKFallback>
    <GKKSPRoot Condition="'$(_GKFallback)' != ''">$(_GKFallback)</GKKSPRoot>
    <ManagedPath Condition="'$(ManagedPath)' == '' And '$(_GKFallback)' != '' And Exists('$(_GKFallback)/KSP_x64_Data/Managed/Assembly-CSharp.dll')">$(_GKFallback)/KSP_x64_Data/Managed</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == '' And '$(_GKFallback)' != '' And Exists('$(_GKFallback)/KSP_Data/Managed/Assembly-CSharp.dll')">$(_GKFallback)/KSP_Data/Managed</ManagedPath>
  </PropertyGroup>

  <Target Name="GKCheckKSPReference" BeforeTargets="BeforeBuild">
    <Warning Condition="'$(_GKFallback)' != ''"
             Text="KSP reference instance '$(KSPPath)' missing — compiling against $(GKKSPRoot) instead. Update KSPPath in GeneKerman.csproj." />
    <Error Condition="'$(ManagedPath)' == ''"
           Text="No KSP install with Managed assemblies found under '$(KSPInstances)'. Pass -p:KSPPath=/path/to/KSP (expects KSP_Data/Managed or KSP_x64_Data/Managed under it)." />
  </Target>

  <!-- Source files -->
  <ItemGroup>
    <!-- Exclude obj/bin: the SDK generates AssemblyAttributes.cs in there and adds it
         itself, so the glob picking it up again is a CS2002 on every incremental build. -->
    <Compile Include="**/*.cs" Exclude="obj/**/*.cs;bin/**/*.cs" />
  </ItemGroup>

  <!-- KSP / Unity References -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedPath)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedPath)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ManagedPath)/UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedPath)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ToolbarControl (optional, for mod toolbar integration) -->
  <ItemGroup Condition="Exists('$(GKKSPRoot)/GameData/001_ToolbarControl/Plugins/ToolbarControl.dll')">
    <Reference Include="ToolbarControl">
      <HintPath>$(GKKSPRoot)/GameData/001_ToolbarControl/Plugins/ToolbarControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ClickThroughBlocker (prevents UI clicks from passing through to game) -->
  <ItemGroup Condition="Exists('$(GKKSPRoot)/GameData/000_ClickThroughBlocker/Plugins/ClickThroughBlocker.dll')">
    <Reference Include="ClickThroughBlocker">
      <HintPath>$(GKKSPRoot)/GameData/000_ClickThroughBlocker/Plugins/ClickThroughBlocker.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- websocket-sharp (live notification push; KSP Mono has no usable ClientWebSocket) -->
  <ItemGroup>
    <Reference Include="websocket-sharp">
      <HintPath>lib/websocket-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- System references for .NET Framework 4.7.2 -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
</Project>
